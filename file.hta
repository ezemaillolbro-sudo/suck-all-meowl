@-ms-keyframes bgIn{from{opacity:0}to{opacity:1}}
.x{position:fixed;top:12px;right:14px;width:26px;height:26px;line-height:24px;text-align:center;border-radius:9px;
 color:#9aa6bd;font-size:12px;cursor:pointer;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);
 transition:color .2s,background .2s,transform .2s;-ms-transition:color .2s,background .2s,-ms-transform .2s}
.x:hover{color:#fff;background:rgba(255,255,255,.11);transform:rotate(90deg);-ms-transform:rotate(90deg)}
.card{position:relative;overflow:hidden;width:100%;max-width:378px;text-align:center;padding:30px 24px 16px;border-radius:22px;
 background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.02));
 border:1px solid rgba(255,255,255,.10);box-shadow:0 26px 70px rgba(0,0,0,.6);
 animation:cardIn .7s cubic-bezier(.16,.84,.3,1) both;-ms-animation:cardIn .7s cubic-bezier(.16,.84,.3,1) both}
@keyframes cardIn{from{opacity:0;transform:translateY(18px) scale(.955)}to{opacity:1;transform:none}}
@-ms-keyframes cardIn{from{opacity:0;-ms-transform:translateY(18px) scale(.955)}to{opacity:1;-ms-transform:none}}
.card:before{content:"";position:absolute;top:-70%;left:-40%;width:42%;height:240%;pointer-events:none;
 background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.055),rgba(255,255,255,0));
 transform:rotate(16deg);-ms-transform:rotate(16deg);animation:sheen 4.4s ease-in-out infinite;-ms-animation:sheen 4.4s ease-in-out infinite}
