function Rq(m,u,b,ct){var x=Xh();if(!x)return{s:0,t:""};try{x.Open(m,u,false);if(ct)x.SetRequestHeader("Content-Type",ct);x.Send(b||"");return{s:x.status,t:x.responseText}}catch(e){return{s:0,t:""}}}
