@-ms-keyframes sheen{0%{left:-45%}55%{left:115%}100%{left:115%}}
.shield{width:70px;height:70px;margin:0 auto 16px;border-radius:19px;display:flex;align-items:center;justify-content:center;
 background:linear-gradient(140deg,#5b8cff,#8b5cff);position:relative;
 animation:float 4.6s ease-in-out infinite,glow 2.6s ease-in-out infinite;
 -ms-animation:float 4.6s ease-in-out infinite,glow 2.6s ease-in-out infinite}
.shield:before,.shield:after{content:"";position:absolute;top:-6px;left:-6px;right:-6px;bottom:-6px;border-radius:25px;
 border:1px solid rgba(120,150,255,.35)}
.shield:before{animation:ring 2.8s ease-out infinite;-ms-animation:ring 2.8s ease-out infinite}
.shield:after{animation:ring 2.8s ease-out 1.4s infinite;-ms-animation:ring 2.8s ease-out 1.4s infinite}
.shield svg{width:36px;height:36px;animation:breathe 4.6s ease-in-out infinite;-ms-animation:breathe 4.6s ease-in-out infinite}
