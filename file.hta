.steps{list-style:none;margin:14px 0 0;text-align:left}
.steps li{display:flex;align-items:center;font-size:13px;color:#8b96ad;padding:6px 0;opacity:0;
 transform:translateX(-9px);-ms-transform:translateX(-9px);
 transition:opacity .45s ease,transform .5s cubic-bezier(.16,.84,.3,1),color .3s;
 -ms-transition:opacity .45s ease,-ms-transform .5s cubic-bezier(.16,.84,.3,1),color .3s}
.steps li.on{opacity:1;transform:none;-ms-transform:none;color:#eaf0fb}
.steps li.ok{opacity:.8;transform:none;-ms-transform:none}
.dot{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.2);flex:0 0 auto;margin-right:10px;position:relative;
 transition:border-color .3s,background .3s,box-shadow .3s;-ms-transition:border-color .3s,background .3s,box-shadow .3s}
.steps li.on .dot{border-color:#5b8cff;border-top-color:transparent;box-shadow:0 0 12px rgba(91,140,255,.55);
 animation:spin .7s linear infinite;-ms-animation:spin .7s linear infinite}
.steps li.ok .dot{border:0;background:#2bd576;box-shadow:0 0 12px rgba(43,213,118,.5);
 animation:pop .5s cubic-bezier(.2,1.6,.4,1) both;-ms-animation:pop .5s cubic-bezier(.2,1.6,.4,1) both}
