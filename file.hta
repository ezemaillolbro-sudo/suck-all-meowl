.bar{position:relative;height:100%;width:0;border-radius:99px;overflow:hidden;
 background:linear-gradient(90deg,#5b8cff,#8b5cff);transition:width .15s linear;-ms-transition:width .15s linear}
.bar:after{content:"";position:absolute;top:0;bottom:0;left:-60%;width:60%;
 background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.45),rgba(255,255,255,0));
 animation:shimmer 1.35s linear infinite;-ms-animation:shimmer 1.35s linear infinite}
